<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- split pane, so the divider between sidebar and content can be dragged to resize the sidebar -->
<SplitPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="mainSplitPane"
            fx:controller="it.unibo.unibodget.view.main.MainViewController"
            styleClass="main-split-pane"
            stylesheets="@style.css"
            prefHeight="700.0" prefWidth="900.0">
    <items>
        <fx:include fx:id="sideBar" source="/it/unibo/unibodget/view/jfx/fxml/main/SideBarView.fxml"/>  <!-- carica la side bar una volta sola per tutti i contesti -->
        <StackPane fx:id="contentArea"/> <!-- cambia il contenuto del contesto -->
    </items>
</SplitPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="sidebar" maxWidth="400.0" minWidth="200.0" prefHeight="700.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unibo.unibodget.view.main.SideBarViewController">
   <children>
      <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="150.0" spacing="8.0">
         <children>
            <Region prefHeight="41.0" prefWidth="30.0" HBox.hgrow="ALWAYS" />
            <MenuButton fx:id="menuButton" alignment="CENTER" minWidth="75.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="75.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Menu">
               <items>
                  <MenuItem fx:id="navDashboardItem" mnemonicParsing="false" text="Dashboard" />
                  <MenuItem fx:id="navConverterItem" mnemonicParsing="false" text="Converter" />
                  <MenuItem fx:id="navPortfolioItem" mnemonicParsing="false" text="Portfolio" />
                  <MenuItem fx:id="navSettingsItem" mnemonicParsing="false" text="Settings" />
               </items>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </MenuButton>
         </children>
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
      </HBox>
      <ScrollPane fitToWidth="true" minHeight="80.0" prefHeight="555.0" prefWidth="150.0" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="walletList" prefHeight="548.0" prefWidth="198.0" spacing="8.0">
               <padding>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </padding>
               <children>
                  <Button alignment="CENTER" mnemonicParsing="false" prefHeight="72.0" prefWidth="203.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="+" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <Label fx:id="totalTitleLabel" maxWidth="1.7976931348623157E308" prefHeight="35.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total:">
         <padding>
            <Insets left="8.0" />
         </padding>
      </Label>
      <Label fx:id="totalBalanceLabel" alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" prefHeight="63.0" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="\$0.00">
         <padding>
            <Insets right="10.0" />
         </padding>
      </Label>
   </children>
</VBox>

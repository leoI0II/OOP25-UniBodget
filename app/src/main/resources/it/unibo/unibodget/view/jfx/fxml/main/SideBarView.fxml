<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox minWidth="200.0" prefHeight="700.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unibo.unibodget.view.main.SideBarViewController">
   <children>
      <HBox prefHeight="60.0" prefWidth="150.0" spacing="8.0">
         <children>
            <Button minWidth="75.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="75.0" text="Close" textAlignment="JUSTIFY" wrapText="true">
               <font>
                  <Font name="JetBrainsMono NF Bold" size="14.0" />
               </font>
            </Button>
            <Region prefHeight="41.0" prefWidth="30.0" HBox.hgrow="ALWAYS" />
            <MenuButton alignment="CENTER" minWidth="75.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="75.0" stylesheets="@style.css" text="Menu">
               <items>
                  <MenuItem mnemonicParsing="false" text="Dashboard" />
                  <MenuItem mnemonicParsing="false" text="Converter" />
                  <MenuItem mnemonicParsing="false" text="Portfolio" />
                  <MenuItem mnemonicParsing="false" text="Settings" />
               </items>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <font>
                  <Font name="JetBrainsMono NF Bold" size="14.0" />
               </font>
            </MenuButton>
         </children>
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
      </HBox>
      <ScrollPane prefHeight="555.0" prefWidth="150.0" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="walletList" prefHeight="548.0" prefWidth="198.0" spacing="8.0">
               <padding>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </padding>
               <children>
                  <Button alignment="CENTER" mnemonicParsing="false" prefHeight="72.0" prefWidth="203.0" text="+">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <Label prefHeight="35.0" prefWidth="217.0" text="Total:">
         <font>
            <Font name="JetBrainsMono NF Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="totalBalanceLabel" alignment="CENTER_RIGHT" prefHeight="63.0" prefWidth="203.0" text="\$0.00">
         <font>
            <Font name="JetBrainsMono NF Bold" size="22.0" />
         </font>
         <padding>
            <Insets right="10.0" />
         </padding>
      </Label>
   </children>
</VBox>

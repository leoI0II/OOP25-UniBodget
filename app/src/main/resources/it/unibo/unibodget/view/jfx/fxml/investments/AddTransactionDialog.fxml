<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unibo.unibodget.view.investments.AddTransactionDialogViewController">
   <children>
      <HBox prefHeight="50.0" spacing="10.0" VBox.vgrow="NEVER">
         <children>
            <Label text="Add Transaction">
               <font><Font size="18.0" /></font>
               <padding><Insets bottom="8.0" left="8.0" top="8.0" /></padding>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleCloseDialog" prefHeight="40.0" prefWidth="40.0" text="X" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
      <TabPane fx:id="transactionTypeTabPane" prefHeight="130.0" prefWidth="480.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="NEVER">
        <tabs>
          <Tab fx:id="buyTab" text="BUY">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </Tab>
          <Tab fx:id="sellTab" text="SELL">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </Tab>
            <Tab fx:id="transferTab" text="TRANSFER">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
              </content>
            </Tab>
        </tabs>
      </TabPane>
      <VBox fx:id="buySellFieldsPanel" prefHeight="534.0" prefWidth="500.0" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Region prefHeight="30.0" prefWidth="480.0" VBox.vgrow="ALWAYS" />
            <ComboBox fx:id="selectedAssetComboBox" maxWidth="1.7976931348623157E308" prefHeight="50.0" prefWidth="480.0" promptText="Select asset ..." VBox.vgrow="ALWAYS" />
            <Region prefHeight="29.0" prefWidth="480.0" VBox.vgrow="ALWAYS" />
            <HBox maxWidth="1.7976931348623157E308" prefHeight="74.0" prefWidth="460.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefHeight="90.0" prefWidth="250.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <Label prefHeight="30.0" prefWidth="120.0" text="Quantity" HBox.hgrow="ALWAYS">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <Region prefHeight="43.0" prefWidth="60.0" HBox.hgrow="ALWAYS" />
                              <ToggleButton fx:id="maxQuantityToggleButton" mnemonicParsing="false" prefHeight="29.0" prefWidth="81.0" text="MAX" HBox.hgrow="ALWAYS">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </ToggleButton>
                           </children>
                        </HBox>
                        <TextField fx:id="quantityTextField" prefHeight="100.0" prefWidth="187.0">
                           <padding>
                              <Insets left="10.0" right="10.0" />
                           </padding>
                        </TextField>
                     </children>
                  </VBox>
                  <Region prefHeight="74.0" prefWidth="150.0" HBox.hgrow="ALWAYS" />
                  <VBox prefHeight="90.0" prefWidth="250.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label prefHeight="30.0" prefWidth="218.0" text="Price per Asset">
                           <font>
                              <Font size="15.0" />
                           </font>
                           <padding>
                              <Insets right="10.0" />
                           </padding>
                        </Label>
                        <TextField fx:id="pricePerAssetTextField" prefHeight="40.0" prefWidth="202.0">
                           <padding>
                              <Insets left="10.0" right="10.0" />
                           </padding>
                        </TextField>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Region prefHeight="25.0" prefWidth="460.0" />
            <HBox maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="460.0" VBox.vgrow="ALWAYS">
               <children>
                  <DatePicker fx:id="datePicker" prefHeight="44.0" prefWidth="147.0" promptText="Date" />
                  <Region prefHeight="35.0" prefWidth="35.0" />
                  <TextField fx:id="feeTextField" prefHeight="45.0" prefWidth="94.0" promptText="Fee" />
                  <Region prefHeight="35.0" prefWidth="40.0" />
                  <TextArea fx:id="notesTextArea" prefHeight="49.0" prefWidth="156.0" promptText="notes" />
               </children>
            </HBox>
            <Region prefHeight="20.0" prefWidth="460.0" VBox.vgrow="ALWAYS" />
            <HBox maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="460.0" spacing="10.0" VBox.vgrow="ALWAYS">
               <children>
                  <ToggleButton fx:id="cashAccountToggleButton" mnemonicParsing="false" prefHeight="35.0" prefWidth="109.0" text="Cash account" HBox.hgrow="ALWAYS" />
                  <ToggleButton fx:id="stableCoinToggleButton" mnemonicParsing="false" prefHeight="42.0" prefWidth="101.0" text="Stable coin" HBox.hgrow="ALWAYS" />
                  <ToggleButton fx:id="noPaymentToggleButton" mnemonicParsing="false" prefHeight="39.0" prefWidth="101.0" text="No payment" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="paymentSourceComboBox" prefHeight="35.0" prefWidth="150.0" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Region prefHeight="20.0" prefWidth="460.0" VBox.vgrow="ALWAYS" />
            <VBox maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="460.0" spacing="10.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label fx:id="totalSpentReceivedTextLabel" prefHeight="18.0" prefWidth="461.0" text="Total Spent">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </Label>
                  <Label fx:id="totalSpentValueLabel" prefHeight="38.0" prefWidth="493.0" text="\$00.00" VBox.vgrow="ALWAYS">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                     <font>
                        <Font size="27.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <Region prefHeight="21.0" prefWidth="460.0" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>

      <!-- CAMPI TRANSFER -->
      <VBox fx:id="transferFieldsPanel" managed="false" prefWidth="500.0" spacing="10.0" visible="false" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>

            <ComboBox fx:id="destinationAccountComboBox" maxWidth="1.7976931348623157E308" prefHeight="50.0" promptText="Destination wallet ..." />

            <HBox maxWidth="1.7976931348623157E308" prefHeight="74.0" spacing="8.0">
               <children>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Asset to transfer">
                           <font><Font size="15.0" /></font>
                           <padding><Insets left="10.0" right="10.0" /></padding>
                        </Label>
                        <ComboBox fx:id="transferAssetComboBox" maxWidth="1.7976931348623157E308" promptText="Select asset ..." />
                     </children>
                  </VBox>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Quantity">
                           <font><Font size="15.0" /></font>
                           <padding><Insets left="10.0" right="10.0" /></padding>
                        </Label>
                        <HBox spacing="4.0">
                           <children>
                              <TextField fx:id="transferQuantityTextField" maxWidth="1.7976931348623157E308" promptText="0.00" HBox.hgrow="ALWAYS" />
                              <ToggleButton fx:id="transferMaxQuantityToggleButton" prefHeight="26.0" text="MAX" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox maxWidth="1.7976931348623157E308" prefHeight="50.0" spacing="8.0">
               <children>
                  <DatePicker fx:id="transferDatePicker" minWidth="150.0" prefHeight="44.0" prefWidth="200.0" />
                  <TextArea fx:id="transferNotesTextArea" prefHeight="49.0" promptText="Notes ..." HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <Region prefHeight="10.0" VBox.vgrow="ALWAYS" />

            <VBox maxWidth="1.7976931348623157E308" spacing="6.0" VBox.vgrow="NEVER">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label text="Quantity to transfer">
                     <font><Font size="18.0" /></font>
                     <padding><Insets left="10.0" /></padding>
                  </Label>
                  <Label fx:id="transferTotalLabel" text="0.00">
                     <font><Font size="27.0" /></font>
                     <padding><Insets left="10.0" /></padding>
                  </Label>
               </children>
            </VBox>

         </children>
      </VBox>

      <Button fx:id="addTransactionButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="39.0" prefWidth="530.0" text="Add Transaction" VBox.vgrow="ALWAYS">
         <font>
            <Font name="FantasqueSansM Nerd Font Regular" size="20.0" />
         </font>
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
      </Button>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
